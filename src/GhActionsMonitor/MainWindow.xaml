<Window x:Class="GhActionsMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Actions Monitor"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="Height" Width="340"
        FontFamily="Segoe UI" FontSize="12" Foreground="#E6EDF3"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="#30FFFFFF"/>
      <Setter Property="Maximum" Value="1"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="10" Background="#E6161B22" BorderBrush="#30FFFFFF" BorderThickness="1"
          Padding="10,8" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
    <Border.ContextMenu>
      <ContextMenu x:Name="Menu"/>
    </Border.ContextMenu>
    <StackPanel>

      <!-- Cabeçalho: arrasta a janela -->
      <DockPanel Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
        <TextBlock x:Name="RefreshBtn" DockPanel.Dock="Right" Text="⟳" FontSize="13" Foreground="#8B949E" Cursor="Hand"
                   ToolTip="Atualizar agora" MouseLeftButtonUp="Refresh_Click" Margin="6,0,0,0"/>
        <Ellipse Width="9" Height="9" Fill="{Binding HeaderBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
      </DockPanel>

      <!-- Execuções -->
      <ItemsControl ItemsSource="{Binding Runs}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="6" Background="#14FFFFFF" Cursor="Hand"
                    MouseLeftButtonUp="Run_Click" Tag="{Binding Url}" ToolTip="Clique para abrir no GitHub">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="#C9D1D9"
                             FontFamily="Consolas" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <Border DockPanel.Dock="Right" Visibility="{Binding BadgeVisibility}" Background="{Binding BadgeBrush}"
                          CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold" Foreground="#0D1117"/>
                  </Border>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding Sub}" Foreground="#8B949E" FontSize="11" TextTrimming="CharacterEllipsis" Margin="14,1,0,0"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding StatusBrush}"
                             Visibility="{Binding ProgressVisibility}" Margin="14,4,0,0"/>
                <TextBlock Text="{Binding JobsText}" Visibility="{Binding JobsVisibility}" Foreground="#8B949E"
                           FontSize="10.5" FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Margin="14,3,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Runners self-hosted -->
      <StackPanel Visibility="{Binding RunnersVisibility}" Margin="0,8,0,0">
        <TextBlock Text="RUNNERS SELF-HOSTED" FontSize="9.5" FontWeight="Bold" Foreground="#6E7681"/>
        <ItemsControl ItemsSource="{Binding Runners}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#8B949E" FontSize="10.5"/>
                  <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Grid Visibility="{Binding MetricsVisibility}" Margin="13,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding CpuText}" FontSize="10" Foreground="#8B949E"/>
                    <ProgressBar Value="{Binding Cpu, Mode=OneWay}" Foreground="#3B9EFF"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding RamText}" FontSize="10" Foreground="#8B949E"/>
                    <ProgressBar Value="{Binding Ram, Mode=OneWay}" Foreground="#A371F7"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Text="{Binding Footer}" Foreground="{Binding FooterBrush}" FontSize="10" Margin="0,6,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Footer}"/>
    </StackPanel>
  </Border>
</Window>
